# ============================================================
# KONFIGURASI SUPABASE
# Ambil dari: https://app.supabase.com -> pilih project
#             -> Project Settings -> API Keys
# ============================================================

# 1) URL project (WAJIB)
NEXT_PUBLIC_SUPABASE_URL=https://diwocedtafaaihfapjxz.supabase.co

# 2) Key publik untuk browser (WAJIB, minimal 20 karakter).
#    Idealnya Publishable key (sb_publishable_...) atau anon key (eyJ...).
#    Untuk sementara diisi key tiruan karena project hanya punya Secret key:
#    browser memanggil proxy internal /api/supabase, dan proxy server yang
#    menambahkan kunci asli. JANGAN taruh Secret key di sini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=proxy-public-key-placeholder-000000

# 3) Kunci server (WAJIB)
#    Hanya dibaca di server (proxy, middleware, API route), tidak pernah
#    dikirim ke browser. Boleh Secret key (sb_secret_...) atau service_role (eyJ...).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_-9G4ZSaQW_tew5sz2xbAKA_lZNZ1-M3
