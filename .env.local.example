# Salin file ini menjadi .env.local lalu isi nilainya.
# Dashboard Supabase -> Project Settings -> API Keys

# URL project (wajib), contoh: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Key publik untuk browser (wajib, minimal 20 karakter).
# Idealnya Publishable key (sb_publishable_...) atau anon key (eyJ...).
# JANGAN pakai Secret key (sb_secret_...) di sini: Supabase memblokirnya di browser.
# Kalau project hanya punya Secret key, isi dengan key tiruan apa saja
# (mis. proxy-public-key-placeholder-000000). Browser akan memakai proxy
# internal /api/supabase dan kunci asli tetap hanya ada di server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci server (wajib). Hanya dibaca di server, tidak pernah dikirim ke browser.
# Boleh Secret key (sb_secret_...) atau service_role key (eyJ...).
SUPABASE_SERVICE_ROLE_KEY=
